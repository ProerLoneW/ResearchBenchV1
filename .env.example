# =============================================================================
# 复制为 .env 后按需修改： cp .env.example .env
# 说明：本文件会被 docker compose 同时用于「变量插值」和「注入容器环境变量」。
#      敏感项一律留空，未设置时功能优雅降级，不会导致启动失败。
# =============================================================================

# -----------------------------------------------------------------------------
# 部署
# -----------------------------------------------------------------------------
# 宿主对外暴露的端口（容器内固定 8765）
HOST_PORT=8765

# -----------------------------------------------------------------------------
# 管理员密码（重要）
# -----------------------------------------------------------------------------
# 留空 = 不启用保护，任何人都能增删改数据（仅建议本机/内网使用）。
# 设置后：POST/PUT/PATCH/DELETE 需要请求头 X-Admin-Password 携带该密码，
#         GET（看板/列表/搜索/统计）与检索类接口（/api/services/*）不受影响。
# 例：ADMIN_PASSWORD=MyStr0ngPwd
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# CORS：允许哪些来源调用本服务
# -----------------------------------------------------------------------------
# * = 允许任意来源（本地 HTML 双击打开时 Origin 是 null，必须用 *）。
# 更安全：改成明确白名单，逗号分隔，例如
#   ALLOW_ORIGINS=https://your.domain,http://localhost:8080
ALLOW_ORIGINS=*

# -----------------------------------------------------------------------------
# Radar 检索联网（可选）
# -----------------------------------------------------------------------------
# 服务器若无法直连 arXiv / Google News，可填代理地址。
# 容器里要访问「宿主」上的代理，用 host.docker.internal（已在 compose 里做了映射）：
#   RADAR_PROXY=http://host.docker.internal:52129
# 也可以填独立的 HTTP 代理：RADAR_PROXY=http://user:pass@proxy.example.com:8080
# 留空则直连（服务器在国外/能直连时无需填写）。
RADAR_PROXY=
# arXiv 检索源：sjtu(国内直连) / ustc(国内直连) / export(官方) / arxiv(官方)
ARXIV_SOURCE=sjtu

# -----------------------------------------------------------------------------
# 飞书（可选，未配置则 TeX→飞书 功能不可用；网页端本身也不支持该功能）
# -----------------------------------------------------------------------------
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# -----------------------------------------------------------------------------
# RSSHub（可选，抓微信公众号资讯用；公共实例常 503，建议自建）
# -----------------------------------------------------------------------------
RSSHUB_BASE=

# -----------------------------------------------------------------------------
# AI 代理（可选，默认关闭）
# -----------------------------------------------------------------------------
# 设为 1 时开放 /api/services/ai/chat：调用方在请求里自备 base_url/model/api_key，
# 服务端转发后立即丢弃，不落盘、不记录。
# 注意：开启后你的服务器会成为一个「任何人带自己的 Key 都能用」的转发代理，
#      请自行评估带宽与滥用风险。不开启时该接口返回 501。
ENABLE_AI_PROXY=0
